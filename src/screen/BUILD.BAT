@ECHO OFF
PATH=C:\BIN
SET INCLUDE=C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /AS /W3 /Os SCREEN.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK /NOI /MAP /CP:4096 SCREEN.OBJ,SCREEN.EXE,SCREEN.MAP,,; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
