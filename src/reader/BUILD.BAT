@ECHO OFF
IF EXIST RUN.OK DEL RUN.OK
SET PATH=T:\BIN
SET INCLUDE=T:\INCLUDE
SET LIB=T:\LIB
CL /nologo /c /G0 /AS /W3 /O CORE.C GO.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /STACK:4096 CORE+GO,GO,,SLIBCE; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /AS /W3 /O TEST.C PROBE.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /STACK:8192 CORE+TEST,DOSTEST,,SLIBCE; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD PROBE,CHILD\PROBE,,SLIBCE; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
DOSTEST > DOSTEST.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS > RUN.OK
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END

