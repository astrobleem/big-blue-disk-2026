@ECHO OFF
IF EXIST RUN.OK DEL RUN.OK
SET PATH=T:\BIN
SET INCLUDE=T:\INCLUDE
SET LIB=T:\LIB
CL /nologo /c /G0 /AS /W3 /O GAME.C ROOM.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /STACK:8192 GAME+ROOM,ROOM,,SLIBCE; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
CL /nologo /c /G0 /AS /W3 /O TEST.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /STACK:16384 GAME+TEST,DOSTEST,,SLIBCE; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
DOSTEST > DOSTEST.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS > RUN.OK
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
